# Builds the Funhouse image for arm64 and amd64 hosts. Multi-stage: build the two stages with
# Vite, then run the room server on a slim Node 24 image as a non-root user. The server
# runs TypeScript directly; there is no server build step.

FROM docker.io/library/node:24.22.2-alpine@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-fund --no-audit
COPY . .
ARG BUILD_COMMIT=dev
ARG BUILD_TIME=
ENV BUILD_COMMIT=$BUILD_COMMIT BUILD_TIME=$BUILD_TIME
RUN npm run build

FROM docker.io/library/node:24.22.2-alpine@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-fund --no-audit && npm cache clean --force
COPY --from=build /app/room ./room
COPY --from=build /app/shared ./shared
COPY --from=build /app/providers ./providers
COPY --from=build /app/cartridges ./cartridges
COPY --from=build /app/studio ./studio
COPY --from=build /app/screen/dist ./screen/dist
COPY --from=build /app/phone/dist ./phone/dist
COPY --from=build /app/landing/dist ./landing/dist
# The rule-based stand-in host that compose.demo.yaml runs when there are no keys.
COPY --from=build /app/tools/stub-model.ts /app/tools/stub-host.ts ./tools/
ARG BUILD_COMMIT=dev
ARG BUILD_TIME=
ENV BUILD_COMMIT=$BUILD_COMMIT BUILD_TIME=$BUILD_TIME
USER node
EXPOSE 8740
CMD ["node", "room/server.ts"]
