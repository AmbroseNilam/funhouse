# Copy to .env and fill in. .env is gitignored. Never commit real values.

# Meta Model API (Muse Spark host, Muse Voice Transcribe, Muse Image)
# Create at https://dev.meta.ai  ->  API keys. Credits show under Billing.
META_MODEL_API_KEY=

# ElevenLabs (the host's voice). Optional: leave blank and the host's lines show as captions, with no sound.
ELEVENLABS_API_KEY=

# TypeSafe AI's Jev (quick judgments: merging duplicate answers, what kind of thing someone said).
# Optional: leave blank and those use their code fallbacks.
JEV_API_KEY=

# Server
PORT=8740

# The address phones open when they scan the QR code, and the only page origin allowed to connect.
# Open the TV page at this same address. On a home network: http://YOUR-LAN-IP:8740
# Mobile browsers only allow the microphone on HTTPS, e.g. https://your-domain.example
# Blank means http://localhost:8740, which only works on this machine.
PUBLIC_URL=

# Optional switches. Each is off unless set to 1.
# AGENTS_ON=1            Lets players invite their own AI agent to a seat through a link.
# GUESTS_OFF=1           Removes AI guests, which otherwise fill empty seats on request.
# WEB_SEARCH_OFF=1       Games only get what the model writes from memory.
# QUIZ_OPEN_ANSWERS=1    Quizmaster takes answers out loud instead of four choices.
# STUDIO_SHOW_HELD=1     Shows the games on hold on every shelf, marked Testing.
# GAME_ROOM_TEXT_ONLY=1  No voice, microphone or paintings. Typing only; Muse Spark still replies.
# GAME_ROOM_DRAW=1       Paints even in text-only mode.

# Optional dollar limits for a public site; see the README.
# COST_LIMITS=
# COST_DIR=
# COST_JUDGE_CODE=
# COST_OWNER_CODE=

# Optional: names Jev judgments to turn off, comma-separated; those use their code fallbacks.
# JEV_DECISIONS_OFF=

# Optional: lets /screen/?studio=all&key=<STUDIO_ALL_KEY> show the Studio games still on hold.
# Off unless both are set. Run outside compose, or add them to compose.yaml.
# STUDIO_ALL=1
# STUDIO_ALL_KEY=
