# Copy to .env and fill in. .env is gitignored. Never commit real values.

# Meta Model API (Muse Spark host, Muse Voice Transcribe, Muse Image)
# Create at https://dev.meta.ai  ->  API keys. Credits show under Billing.
META_MODEL_API_KEY=

# OpenAI (speech only: stands in for any line ElevenLabs can't start, and is the voice with no ElevenLabs key)
# Create at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ElevenLabs (the host's voice). Optional: leave blank to use OpenAI's voice instead.
ELEVENLABS_API_KEY=

# TypeSafe AI's Jev (quick judgments: merging duplicate answers, what kind of thing someone said).
# Optional: leave blank and those use their code fallbacks.
JEV_API_KEY=

# Server
PORT=8740

# The HTTPS URL phones will open when they scan the QR code.
# Mobile browsers only allow the microphone on HTTPS, e.g. https://your-domain.example
PUBLIC_URL=
