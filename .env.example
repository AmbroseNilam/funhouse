# Copy to .env and fill in. .env is gitignored. Never commit real values.

# Meta Model API (Muse Spark host, Muse Voice Transcribe, Muse Image)
# Create at https://dev.meta.ai  ->  API keys. Credits show under Billing.
META_MODEL_API_KEY=

# OpenAI (text-to-speech only, model gpt-4o-mini-tts)
# Create at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional fallback text-to-speech. Leave blank if unused.
ELEVENLABS_API_KEY=

# Server
PORT=8740

# The HTTPS URL phones will open when they scan the QR code.
# Mobile browsers only allow the microphone on HTTPS. Set this to your
# The public address, e.g. https://funhouse.your-tailnet.ts.net
PUBLIC_URL=
